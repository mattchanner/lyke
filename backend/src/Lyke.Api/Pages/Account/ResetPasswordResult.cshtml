@page "/account/reset-password-result"
@model Lyke.Api.Pages.Account.ResetPasswordResultModel
@{
    ViewData["Title"] = Model.Success ? "Password Reset" : "Reset Failed";
}

@if (Model.Success)
{
    <div class="icon icon-success">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
    </div>
    <h1>Password Reset!</h1>
    <p>Your password has been changed successfully. You can close this page and log in with your new password.</p>
}
else
{
    <div class="icon icon-error">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </div>
    <h1>Reset Failed</h1>
    <p>This password reset link is invalid or has expired. Please request a new one from the app.</p>
}
